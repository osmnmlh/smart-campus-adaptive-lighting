{
  "name": "@smart-campus/dashboard-workspace",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke:mvp-integration": "node scripts/mvp-integration-smoke.mjs",
    "test:smoke:mvp-integration": "node --test scripts/mvp-integration-smoke.test.mjs",
    "infra:config": "docker compose --env-file infrastructure/.env.example -f infrastructure/compose.yaml config",
    "infra:up": "docker compose --env-file infrastructure/.env -f infrastructure/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file infrastructure/.env -f infrastructure/compose.yaml down --remove-orphans",
    "infra:ps": "docker compose --env-file infrastructure/.env -f infrastructure/compose.yaml ps",
    "infra:logs": "docker compose --env-file infrastructure/.env -f infrastructure/compose.yaml logs --tail=200"
  },
  "devDependencies": {
    "prettier": "3.9.5"
  },
  "overrides": {
    "fast-uri": "3.1.4"
  }
}
