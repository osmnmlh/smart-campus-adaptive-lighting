NODE_ENV=development

FRONTEND_PORT=3000
BACKEND_PORT=3001

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/dashboard
CORS_ORIGINS=http://localhost:3000

DASHBOARD_DEV_TOKEN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=smart_campus
POSTGRES_USER=
POSTGRES_PASSWORD=

MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=smart-campus-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CONNECT_TIMEOUT_MS=5000
MQTT_RECONNECT_PERIOD_MS=1000
MQTT_KEEPALIVE_SECONDS=30
MQTT_MAX_PAYLOAD_BYTES=16384
MQTT_DEDUP_CAPACITY=10000
MQTT_LIVENESS_SWEEP_MS=5000

# MVP energy analytics defaults; deployment may override the real lamp nominal power.
ENERGY_NOMINAL_LAMP_POWER_W=10
ENERGY_MEASUREMENT_STALE_MS=15000
ENERGY_MAX_INTEGRATION_GAP_MS=30000

# MVP/mock defaults only; these are configurable and are not field guarantees.
FAIL_SAFE_BRIGHTNESS_PERCENT=100
DAY_NIGHT_THRESHOLD_LUX=100
HEARTBEAT_INTERVAL_MS=2000
NODE_OFFLINE_TIMEOUT_MS=6000
