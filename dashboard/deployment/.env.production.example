COMPOSE_PROJECT_NAME=smart-campus
IMAGE_TAG=local

APP_DOMAIN=dashboard.example.com
MQTT_DOMAIN=mqtt.example.com
ACME_EMAIL=ops@example.com

NEXT_PUBLIC_DASHBOARD_DATA_MODE=live
NEXT_PUBLIC_BACKEND_HTTP_URL=
NEXT_PUBLIC_BACKEND_WS_URL=

BACKEND_MQTT_CLIENT_ID=smart-campus-backend
BACKEND_MQTT_USERNAME=backend_ingest
BACKEND_MQTT_PASSWORD=CHANGE_ME_BACKEND_MQTT_PASSWORD
GATEWAY_MQTT_USERNAME=gateway_gw1
GATEWAY_MQTT_PASSWORD=CHANGE_ME_GATEWAY_MQTT_PASSWORD
MQTT_PASSWORD_FILE_PATH=./secrets/mosquitto/passwords

MQTT_CONNECT_TIMEOUT_MS=5000
MQTT_RECONNECT_PERIOD_MS=1000
MQTT_KEEPALIVE_SECONDS=30
MQTT_MAX_PAYLOAD_BYTES=16384
MQTT_DEDUP_CAPACITY=10000
MQTT_LIVENESS_SWEEP_MS=5000
