{
  "name": "@smart-campus/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace=@smart-campus/contracts",
    "dev": "next dev",
    "prebuild": "npm run build --workspace=@smart-campus/contracts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run build --workspace=@smart-campus/contracts",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "pretest": "npm run build --workspace=@smart-campus/contracts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@smart-campus/contracts": "0.1.0",
    "@xyflow/react": "12.11.2",
    "echarts": "6.1.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
