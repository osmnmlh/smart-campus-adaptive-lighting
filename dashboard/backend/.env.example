NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
CORS_ORIGINS=http://localhost:3000
WEBSOCKET_PATH=/ws/v1
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
WEBSOCKET_MAX_PAYLOAD_BYTES=16384
WEBSOCKET_REPLAY_CAPACITY=200

DASHBOARD_DEV_TOKEN=

MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=smart-campus-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CONNECT_TIMEOUT_MS=5000
MQTT_RECONNECT_PERIOD_MS=1000
MQTT_KEEPALIVE_SECONDS=30
MQTT_MAX_PAYLOAD_BYTES=16384
MQTT_DEDUP_CAPACITY=10000
MQTT_LIVENESS_SWEEP_MS=5000
